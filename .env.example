# Copia este fichero a .env. Todo tiene un valor por defecto: sirve tal cual para desarrollar.

# --- Postgres y Qdrant (compose.yaml). Los puertos solo escuchan en 127.0.0.1. ---
POSTGRES_USER=obrador
POSTGRES_PASSWORD=obrador
POSTGRES_DB=obrador
POSTGRES_PORT=55432
QDRANT_PORT=56333
QDRANT_URL=http://127.0.0.1:56333

# --- Modelo local (Ollama, fuera de Docker) ---
# qwen3.5:9b-mlx es la versión para Apple Silicon. En Linux o en un Mac Intel, qwen3.5:9b.
# Más rápido y con menos memoria, a cambio de peor castellano: llama3.2:3b.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b-mlx
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Motor (engine/server.mjs) ---
ENGINE_PORT=8790
# Dónde se escribe el markdown de cierre de cada expediente. Por defecto, output/ en la raíz.
# OUTPUT_DIR=

# --- Web en producción (web/serve.mjs) ---
WEB_PORT=4310
# 1 solo si hay un proxy de confianza delante: entonces el límite por IP lee X-Forwarded-For.
TRUST_PROXY=0
